    </div>
  </div>
</div>
{%- if item.show_share_buttons -%}
  <div class="container-indent wrapper-social-icon">
    <div class="container text-center">
      {%- include 'addthis' -%}
    </div>
  </div>
  {%- unless blog.comments_enabled? -%}<div class="clear-gap"></div>{%- endunless -%}
{%- endif -%}

{%- if blog.comments_enabled? -%}
  {%- if number_of_comments > 0 -%}
    <div class="container-indent">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-xs-12 col-md-10 col-lg-8 col-md-auto">
            <h6 class="tt-title-border" id="comments">
              {{ 'blogs.comments.comments_with_count' | t: count: number_of_comments }}
            </h6>

            {%- paginate article.comments by 100 -%}
              {%- comment -%}
                #comments is required, it is used as an anchor link by Shopify.
              {%- endcomment -%}
              {%- if new_comment -%}
                <p class="tt-base-color">
                  {%- if blog.moderated? -%}
                    {{ 'blogs.comments.success_moderated' | t }}
                  {%- else -%}
                    {{ 'blogs.comments.success' | t }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              <div class="tt-comments-layout">
                {%- comment -%}
                  If a comment was just submitted with no blank field, show it.
                {%- endcomment -%}
                {%- if new_comment -%}
                  {%- include 'blog-comment' -%}
                {%- endif -%}

                {%- for comment in article.comments -%}
                  {%- unless comment.id == new_comment_id -%}
                    {%- include 'blog-comment' -%}
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            {%- endpaginate -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="container-indent">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xs-12 col-md-10 col-lg-8 col-md-auto">
          <div class="form-single-post contact-form form-default">
            <h6 class="tt-title-border" id="addcomment">{{ 'blogs.comments.title' | t }}</h6>
            {%- form 'new_comment', article -%}
              {{ form.errors | default_errors }}

              <div class="form-group">
                <label for="inputName" class="control-label">{{ 'blogs.comments.name' | t }}</label>
                <input
                  type="text"
                  name="comment[author]"
                  class="form-control"
                  id="inputName"
                  placeholder="{{ 'blogs.fields.name' | t }}"
                >
              </div>
              <div class="form-group">
                <label for="inputEmail" class="control-label">{{ 'blogs.comments.email' | t }}</label>
                <input
                  type="email"
                  name="comment[email]"
                  class="form-control"
                  id="inputEmail"
                  placeholder="{{ 'blogs.fields.email' | t }}"
                >
              </div>
              <div class="form-group">
                <label for="textarea" class="control-label">{{ 'blogs.comments.message' | t }}</label>
                <textarea
                  class="form-control"
                  name="comment[body]"
                  id="textarea"
                  placeholder="{{ 'blogs.fields.message' | t }}"
                  rows="8"
                ></textarea>
              </div>

              {%- if blog.moderated? -%}
                <p class="fine-print">{{ 'blogs.comments.moderated' | t }}</p>
                <br>
              {%- endif -%}

              <div class="form-group">
                <button type="submit" class="btn ttbtnmainstyle">{{ 'blogs.comments.post' | t }}</button>
              </div>
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<script defer>
  // Set the lightning deal start and end dates
  const lightningStartDate = new Date('{{ settings.startdate }}');
  const lightningEndDate = new Date('{{ settings.enddate }}');

  // Function to update the countdown timer
  function updateCountdown() {
    const currentDate = new Date();
    const timeRemaining = lightningEndDate - currentDate;

    if (timeRemaining > 0) {
      const totalHours = Math.floor(timeRemaining / (1000 * 60 * 60)); // Convert total ms to hours
      const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);

      document.getElementById('countdown-{{section.id}}').innerHTML = 
        `<div><span>${totalHours}</span><br>Hours</div>:<div><span>${minutes}</span><br>Mins</div>:<div><span>${seconds}</span><br>Secs</div>`;
      
      document.getElementById('countdown-{{section.id}}').style.display = 'block';
    } else {
      document.getElementById('countdown-{{section.id}}').style.display = 'none';
      document.querySelector("#LDdeal-{{ section.id }}").classList.add("hide");
      // Optional: show sold out container if needed
      // document.querySelector("#soldallproduct-{{ section.id }}").classList.remove("hide");
    }
  }

  // Run updateCountdown every second
  setInterval(updateCountdown, 1000);
</script>

