<style>
  /* CountDown */
.slide-count p {
  color: #06374F;
  font-family: MikadoMedium;
  font-size: 15px;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  margin: 0;
}
.end-deal-counter div span {
  color: #D41F3B;
  font-family: MikadoMedium;
  font-size: 25px;
  font-style: normal;
  font-weight: 700;
  line-height: 28px;
}
.end-deal-counter,.end-deal-counter div {
  color: #06374F;
  font-family: MikadoMedium;
  font-size: 12px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
}
.slide-count {
  display: flex;
  align-items: center;
  gap: 15px;
  background: #ffffff;
  border-radius: 5px;
  padding: 8px;
  justify-content: center;
}
.end-deal-counter {
  display: flex !important;
  align-items: center;
  gap: 10px;
}
.end-deal-counter div {
   display: block;
   text-align: center
}
.slider-countdown .slide-cus-btn {
  color: #FFF;
  font-family: MikadoMedium;
  font-size: 18px;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  width: 100%;
