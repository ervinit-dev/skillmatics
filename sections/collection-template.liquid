 {% if section.settings.link2 != blank %}</a>{% endif %}

</div> 
{% elsif section.settings.showimage1 %}
<div class="all-collection-{{ collection.handle }}">
{% if section.settings.link1 != blank %}
    <a href="{{section.settings.link1 }}" aria-label="{{ collection.handle }} link">{% endif %}
      <img id ="{{ section.settings.tracking-id }}"  src="{{ section.settings.image1 | img_url:'1600x' }}" class="desktop-only" loading="eager" fetchpriority="high" decoding="async" alt="{{ collection.handle }}" width="100%" height="100%" srcset="{{ section.settings.image1 | img_url:'2000x'}}">
      <img id ="{{ section.settings.tracking-id }}" src="{{ section.settings.mob-image1 | img_url:'700x' }}" class="mobile-only" loading="eager" fetchpriority="high" decoding="async" alt="{{ collection.handle }}" width="100%" height="100%" srcset="{{ section.settings.mob-image1 | img_url:'700x'}}">
 {% if section.settings.link1 != blank %}</a>{% endif %}
    <div class="slider-countdown">
    <div class="slide-count">
      <p>ENDS IN</p>
      <div class="end-deal-counter coun-timer-deal" id="countdown-{{section.id}}"></div>
    </div>
  </div>
</div>
  {% endif %}
{% include 'collection-template' current_pagination_limit: settings.pagination_limit %}
{% if section.settings.showimagebtm2 %}
<div class="collection-{{ collection.handle }}">
  {% if section.settings.btmlink2 != blank %}
    <a href="{{section.settings.btmlink2 }}" aria-label="{{ collection.handle }} link">{% endif %}
      <img id ="{{ section.settings.tracking-id }}"  src="{{ section.settings.imagebtm2 | img_url:'1600x' }}" class="desktop-only" loading="eager" fetchpriority="high" decoding="async" alt="{{ collection.handle }}" width="100%" height="100%" srcset="{{ section.settings.imagebtm2 | img_url:'2000x'}}">
      <img id ="{{ section.settings.tracking-id }}" src="{{ section.settings.mob-imagebtm2 | img_url:'700x' }}" class="mobile-only" loading="eager" fetchpriority="high" decoding="async" alt="{{ collection.handle }}" width="100%" height="100%"  srcset="{{ section.settings.mob-imagebtm2 | img_url:'700x'}}">
 {% if section.settings.btmlink2 != blank %}   </a>{% endif %}
</div>
  {% endif %}
  {% if section.settings.showimagebtm %}
<div class="collection-{{ collection.handle }} btm-banner">
  {% if section.settings.btmlink != blank %}      <a href="{{section.settings.btmlink }}" aria-label="{{ collection.handle }} link">{% endif %}
      <img  id ="{{ section.settings.tracking-id }}"  src="{{ section.settings.imagebtm | img_url:'1600x' }}" class="desktop-only" loading="eager" fetchpriority="high" decoding="async" alt="{{ collection.handle }}" width="100%" height="100%" srcset="{{ section.settings.imagebtm | img_url:'1800x'}}">
      <img id ="{{ section.settings.tracking-id }}"  src="{{ section.settings.mob-imagebtm | img_url:'450x' }}" class="mobile-only" loading="eager" fetchpriority="high" decoding="async" alt="{{ collection.handle }}" width="100%" height="100%" srcset="{{ section.settings.mob-imagebtm | img_url:'450x'}}">
  {% if section.settings.btmlink != blank %}      </a>{% endif %}
</div>
{% endif %}

<script >
  // Set the lightning deal start and end dates
    const lightningStartDate = new Date('{{ settings.startdate }}'); // Example start date
    const lightningEndDate = new Date('{{ settings.enddate }}'); // Example end date
    const currentDate = new Date(); // Get the current date and time
 
     // Function to update the countdown timer
    function updateCountdown() {
        const currentDate = new Date();
        const timeRemaining = lightningEndDate - currentDate; // Calculate time remaining

        if (timeRemaining > 0) {
            const hours = Math.floor((timeRemaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);
            
            document.getElementById('countdown-{{section.id}}').innerHTML = 
                `<div><span> ${hours}</span><br>Hours</div>:<div><span> ${minutes}</span><br>Mins</div>:<div><span>${seconds}</span><br>Secs</div>`;
            document.getElementById('countdown-{{section.id}}').style.display = 'block'; // Show countdown
        } else {
            document.getElementById('countdown-{{section.id}}').style.display = 'none';
           // Add 'hide' class to the section-lightning-deal container
          document.querySelector("#LDdeal-{{ section.id }}").classList.add("hide");

  // Remove 'hide' class from the sold-all product container
       //   document.querySelector("#soldallproduct-{{ section.id }}").classList.remove("hide");// Hide countdown if time's up
        }
    }

  
    // Set an interval to update the countdown every second (1000 milliseconds)
    setInterval(updateCountdown, 1000);
</script>

