<style>
    .multicolumn{  text-align: center;}
     @media (max-width: 789px){
  .multicolumn img { max-width: 120px;}
     }
   .custom-slideshow  ul.slick-dots{    margin-top: -40px !important;}
   .custom-slideshow .slick-dots li button {
      width: 30px;border-radius:0;
      height: 5px;
  }
  /* Define the keyframes for the background color animation */
  @keyframes backgroundProgress {
    0% {
      background-color: #ffffff;
    }
    100% {
      background-color: #06374f;
    }
  }

  /* Apply styles to the slick-active button */
  .custom-slideshow .slick-dots .slick-active button {
    background-color: #ffffff; /* Initial background color */
    animation: backgroundProgress 6s forwards; /* Apply the animation */
  }

  /* Optional: Ensure the button's transition is smooth */
  .custom-slideshow .slick-dots button {
    transition: background-color 0.3s ease;
  }
  .custom-slideshow:not(.slick-initialized) .slidebanner:not(.slidebanner1){display:none;}

  /* CountDown */
  .custom-banner-gd {
    position: relative;
}
.slide-count p {
  color: #06374F;
  font-family: MikadoMedium;
  font-size: 15px;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  margin: 0;
}
.end-deal-counter div span {
  color: #D41F3B;
  font-family: MikadoMedium;
  font-size: 25px;
  font-style: normal;
  font-weight: 700;
  line-height: 28px;
}
.end-deal-counter,.end-deal-counter div {
  color: #06374F;
  font-family: MikadoMedium;
  font-size: 12px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
}
.slide-count {
  display: flex;
  align-items: center;
  gap: 15px;
  background: #ffffff;
  border-radius: 5px;
  padding: 8px;
  justify-content: center;
}
.end-deal-counter {
  display: flex !important;
  align-items: center;
  gap: 10px;
}
.end-deal-counter div {
   display: block;
   text-align: center
}
.slider-countdown .slide-cus-btn {
  color: #FFF;
  font-family: MikadoMedium;
  font-size: 18px;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  width: 100%;
  max-width: 200px;
  height: 40px;
  background: #CC3E3E;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin:10px auto 0; 
}
.cust-time {
  position: relative;
}
.slider-countdown {
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 280px;
}

@media (min-width:1501px) and (max-width: 1700px){
  .slide-count { gap: 10px; padding: 5px }
  .end-deal-counter { gap: 10px; }
  .end-deal-counter div span { font-size: 24px; line-height: 20px; }
  .slider-countdown .slide-cus-btn { font-size: 16px; max-width: 200px; height: 35px; margin: 5px auto 0 }
  .slide-count p,.end-deal-counter,.end-deal-counter div { font-size: 14px; }
  .slider-countdown { bottom: 8%; left: 50%; transform: translateX(-50%); max-width: 280px; }
}

