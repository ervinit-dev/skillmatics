@media (min-width: 790px) and (max-width: 999px) {
  .slide-count { gap: 5px; padding: 4px }
  .end-deal-counter { gap: 5px; }
  .end-deal-counter div span { font-size: 16px; line-height: 16px; }
  .slider-countdown .slide-cus-btn { font-size: 16px; max-width: 140px; height: 28px; margin: 5px auto 0 }
  .slide-count p,.end-deal-counter,.end-deal-counter div { font-size: 10px; }
  .slider-countdown { bottom: 0px; left: 50%; transform: translateX(-50%); max-width: 200px; }
}

@media (min-width: 651px) and (max-width: 789px) {
  .slider-countdown { position: absolute; bottom: 5%; left: 14%; transform: translateX(-14%); width: 100%; max-width: 280px; }
}
@media (min-width: 420px) and (max-width:650px) {
  .slider-countdown { bottom: 11px; left:115px; max-width: 105px; }
  .slide-count { gap: 2px; padding: 3px }
  .end-deal-counter { gap: 2px; }
  .end-deal-counter div span { font-size: 10px; line-height: 12px; }
  .slider-countdown .slide-cus-btn { font-size: 12px; max-width: 140px; height: 25px; margin: 5px auto 0 }
  .slide-count p,.end-deal-counter,.end-deal-counter div { font-size: 7px; }
}
@media (max-width: 420px){
  .slide-count { gap: 2px; padding: 3px }
  .end-deal-counter { gap: 2px; }
  .end-deal-counter div span { font-size: 10px; line-height: 12px; }
  .slider-countdown .slide-cus-btn { font-size: 12px; max-width: 140px; height: 25px; margin: 5px auto 0 }
  .slide-count p,.end-deal-counter,.end-deal-counter div { font-size: 7px; }
  .slider-countdown { bottom: 5px; left: 105px; max-width: 105px; }
}
</style>
{%- assign item = section.settings -%}
{%- assign grid = section.settings.items -%}
{%- assign mobgrid = section.settings['mob-items'] -%}
<div
  id="section-{{ section.id }}"
  class="{% if item.top_offset == 'none' %}nomargin {% elsif item.top_offset == 'small' %}tt-offset-small {% endif %} custom-banner-row"
>
  <div class=" full-width-container">
    <div class="{%- if section.blocks.size > 1 -%} custom-{% endif %}slideshow  noarrow custom-slideshow-container">
      {%- for block in section.blocks -%}
        {%- assign item = block.settings -%}
        <div class="slider-itemslider">
          <a href="{{item.collection }}" aria-label="bannerlinks" rel="link">
            <div class="grid-column-itemslider">
              <div class="custom-banner-gd">
                {%- unless item.image == blank -%}
                  {%- if forloop.index == 1 -%}
                    {% comment %}  <link rel="preload" as="image" href="{{ item.image | img_url: ''}}">{% endcomment %}
                  {%- endif %}

                  <img
                    class="slidebanner{{ forloop.index }} slidebanner mobile-{%- unless  item.image == blank -%}hide{%- endunless -%}"
                    decoding="async"
                    srcset="{{ item.image | img_url: '1600x'}}"
                    id="{{ section.settings.tracking-id  | strip}}{{ forloop.index }}"
                    alt="banner image"
                    width="100%"
                    height="100%"
                    decoding="async"
                    {%- if forloop.index == 1 -%}
                      fetch-priority="high"
                      loading="eager"
                    {% else %}
                      fetch-priority="high"
                      loading="eager"
                    {%- endif %}
                    {% comment %}
                      srcset="{{ item.image | img_url: '1600x'}}"
                    {% endcomment %}
                    {%- if forloop.index == 1 -%}
                    {% endif %}
                  >
                {%- endunless -%}
                {%- unless item.image == blank -%}
                  {%- if forloop.index == 1 -%}
                    {% comment %}  <link rel="preload" as="image" href="{{ item.mob-image | img_url: '500x598'}}">{% endcomment %}
                  {%- endif %}

                  <img
                    class="slidebanner{{ forloop.index }} slidebanner desktop-{%- unless  item.image == blank -%}hide {%- endunless -%} "
                    decoding="async"
                    srcset="{{ item.mob-image | img_url: '450x'}}"
                    id="{{ section.settings.tracking-id  | strip}}{{ forloop.index }}"
                    alt="banner image"
                    width="100%"
                    height="100%"
                    loading="eager"
                    {%- if forloop.index == 1 -%}
                      fetch-priority="high"
                      loading="eager"
                    {% else %}
                      fetch-priority="high"
                      loading="eager"
                    {%- endif %}
                    {% comment %}
                      srcset="{{ item.mob-image | img_url: '450x'}}"
                    {% endcomment %}
                    {%- if forloop.index == 1 -%}
                    {% endif %}
                  >
                {%- endunless -%}
                  {%- if forloop.index == 1 -%}
                    <div class="slider-countdown">
                      <div class="slide-count">
                        <div class="end-deal-counter coun-timer-deal" id="countdown-{{ section.id }}"></div>
                      </div>
                    </div>
                  {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% comment %}
  <script>
    // Select all images with the class 'lazyload'
  const lazyImages = document.querySelectorAll('img.lazyload');

  // Loop through the NodeList and remove the class
  lazyImages.forEach(img => {
    img.classList.remove('lazyload');
  });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const lazyImages = document.querySelectorAll('img[loading="lazy"]');
      lazyImages.forEach(img => img.removeAttribute('loading'));
    });
  </script>
{% endcomment %}

<script defer >
  // Set the lightning deal start and end dates
    const lightningStartDate = new Date('{{ settings.startdate }}'); // Example start date
    const lightningEndDate = new Date('{{ settings.enddate }}'); // Example end date
    const currentDate = new Date(); // Get the current date and time
 
     // Function to update the countdown timer
    function updateCountdown() {
        const currentDate = new Date();
        const timeRemaining = lightningEndDate - currentDate; // Calculate time remaining

        if (timeRemaining > 0) {
            const hours = Math.floor((timeRemaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);
            
            document.getElementById('countdown-{{section.id}}').innerHTML = 
                `<div><span> ${hours}</span><br>Hours</div>:<div><span> ${minutes}</span><br>Mins</div>:<div><span>${seconds}</span><br>Secs</div>`;
            document.getElementById('countdown-{{section.id}}').style.display = 'block'; // Show countdown
        } else {
            document.getElementById('countdown-{{section.id}}').style.display = 'none';
           // Add 'hide' class to the section-lightning-deal container
          document.querySelector("#LDdeal-{{ section.id }}").classList.add("hide");

  // Remove 'hide' class from the sold-all product container
       //   document.querySelector("#soldallproduct-{{ section.id }}").classList.remove("hide");// Hide countdown if time's up
        }
    }

  
    // Set an interval to update the countdown every second (1000 milliseconds)
    setInterval(updateCountdown, 1000);
</script>

