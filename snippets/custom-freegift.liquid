<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Configuration
    const giftamt = {{ settings.free-gift-amt | plus:0 }};
    const freeGiftAddedKey = "_cfg_ad";
    const freeGiftValidKey = "_cfg_vld";

    // Utility: Wait for an element to appear in the DOM
    function waitForElement(selector, callback, interval = 100, timeout = 5000) {
      const startTime = Date.now();
      const timer = setInterval(() => {
        const element = document.querySelector(selector);
        if (element) {
          clearInterval(timer);
          callback(element);
        } else if (Date.now() - startTime > timeout) {
          clearInterval(timer);
          console.warn(`Element "${selector}" not found within timeout`);
        }
      }, interval);
    }

    // Utility: Fetch cart data using AJAX
    function fetchCart(callback) {
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => callback(cart))
        .catch(err => console.error('Cart fetch failed:', err));
    }

    // Remove "Free Gift" products from view
    function removeQuantity(items) {
      for (let i = 0; i < items.length; i++) {
        if (items[i].title.includes('Free Gift')) {
          try {
            document.querySelector(`.hs-item-${items[i].variant_id}`).remove();
          } catch (e) {
            console.log(e);
          }
        }
      }
    }

    // Validate whether user qualifies for the free gift
    function validateOfferRefresh(cart) {
      if ((cart.total_price / 100) < giftamt) {
        localStorage.setItem(freeGiftValidKey, 'false');
      } else {
        localStorage.setItem(freeGiftValidKey, 'true');
        checkFreeGift(cart);
      }
    }

    // Add gift product to cart
    function addGift(lineItemId) {
      const buttonClicked = document.querySelector(`[data-id="free-gift-${lineItemId}"]`);
      document.querySelectorAll('.free-gift-container button').forEach((item) => {
        item.disabled = true;
        item.style.opacity = '0.8';
      });
      buttonClicked.innerText = 'Adding...';

      const params = {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ quantity: 1, id: lineItemId }),
      };

      fetch('/cart/add.js', params)
        .then(res => res.json())
        .then(() => {
          console.log('Free gift added');
          window.HS_SLIDE_CART_UPDATE?.();
          localStorage.setItem(freeGiftAddedKey, 'true');
          const claimedText = document.querySelector('.hs-text-free-shipping');
          if (claimedText) {
            claimedText.innerText = "Congratulations! You have claimed your free gift!";
          }
        })
        .catch(err => console.error('Error adding free gift:', err));
    }

    // Inject free gift offer UI
    function showFreeGiftOffer(cart) {
      if (typeof FreeGiftOfferActive === 'undefined' || !FreeGiftOfferActive) return;

      const alreadyAdded = localStorage.getItem(freeGiftAddedKey) === 'true';
      const isValid = localStorage.getItem(freeGiftValidKey) === 'true';

      if (!isValid) {
        document.querySelector('.free-gift-container')?.remove();
        return;
      }

      if (alreadyAdded) {
        document.querySelector('.free-gift-container')?.remove();
        return;
      }

      // Avoid injecting multiple times
      if (document.querySelector('.free-gift-container')) return;

      const freeGiftSnippet = `
        <div class="row free-gift-container freegift-scroll">
          {% assign productsData = collections['free-gift'].products %}
          {% for item in productsData %}
            {% if item.variants.first.available %}
              <div class="free-product card">
                <a href="{{ item.url }}">
                  <div class="custom-free-tag">
                    <svg width="78" height="22" viewBox="0 0 78 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0 10C0 4.47715 4.47715 0 10 0H78L72.4286 22H0V10Z" fill="#EFDD68"/>
                    </svg>
                  </div>
                  <img src="{{ item.featured_image | product_img_url:"large" }}" alt="product image" loading="lazy" width="150px" height="100px">
                </a>
                <a href="{{ item.url }}">
                  <p class="title">{{ item.title }}</p>
                </a>
                <div product-id="{{ item.id }}" class="arv-collection arv-collection--{{ item.id }}"></div>
                <p class="tt-price price cus-price">
                  <span class="compare-price">{{ item.compare_at_price | money }}</span>
                  <span class="free-tag">Free</span>
                </p>
                <button onclick="addGift({{ item.variants.first.id }})" data-id="free-gift-{{ item.variants.first.id }}">Add</button>
              </div>
            {% endif %}
          {% endfor %}
        </div>`;

      const rewardsSection = document.querySelector('.hs-rewards-content');
      if (rewardsSection) {
        rewardsSection.insertAdjacentHTML("afterend", freeGiftSnippet);
        try {
          aliReviewsAddRatingCollection?.(); // if exists
        } catch (e) {
          console.warn('AliReviews rating load error', e);
        }
      }

      if (cart.items) {
        localStorage.setItem('items', JSON.stringify(cart.items));
        removeQuantity(cart.items);
      }
    }

    // Bootstrap everything after waiting for DOM + Shopify + Rewards element
    waitForElement('.hs-rewards-content', () => {
      fetchCart(cart => {
        validateOfferRefresh(cart);
        showFreeGiftOffer(cart);
      });
    });

    // Hook when slide cart opens (re-renders)
    window.HS_SLIDE_CART_OPENED = function () {
      fetchCart(cart => {
        validateOfferRefresh(cart);
        showFreeGiftOffer(cart);
      });
    };
  });
</script>
